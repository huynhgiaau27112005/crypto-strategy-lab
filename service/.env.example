# =====================================================================
# service/.env.example — TEMPLATE, được commit vào git.
# KHÔNG BAO GIỜ điền giá trị thật (key, token, mật khẩu production) vào
# file này. Copy sang service/.env (đã gitignore) rồi điền ở đó.
# =====================================================================

# --- API server -------------------------------------------------------
PORT=3000
WEB_ORIGIN=http://localhost:5173
# development | production — đổi cách log và mức chi tiết của lỗi.
# NODE_ENV=development
# json | pretty (mặc định: pretty khi NODE_ENV != production)
# LOG_FORMAT=

# --- Database (TimescaleDB / PostgreSQL) ------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=6543
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=crypto_strategy_lab

# --- Auth -------------------------------------------------------------
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- Redis (cache + BullMQ queue) -------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6381

# Cổng /metrics của tiến trình worker (worker.ts), mặc định 3001.
# WORKER_METRICS_PORT=3001

# --- Binance ----------------------------------------------------------
# HIỆN TẠI KHÔNG BẮT BUỘC. Toàn bộ market data của dự án đi qua
# `BinanceClient`, vốn chỉ gọi REST/WebSocket CÔNG KHAI (klines, aggTrade)
# — không ký request, không cần key. `createSpotClient()` trong
# market-data/config.ts là chỗ duy nhất đọc 2 biến này, và hiện chưa có
# nơi nào gọi nó. Chỉ cần điền khi sau này dùng endpoint cần xác thực.
#
# Tên biến phải đúng như dưới đây — code đọc `BINANCE_API_SECRET`,
# KHÔNG phải `BINANCE_SECRET_KEY`.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- AI Strategy (tab "AI Strategy") ----------------------------------
# Bỏ trống cả hai key -> hệ thống dùng FakeLlmProvider: code Python sinh ra
# là code mẫu cố định, KHÔNG gọi LLM thật. Tab AI Strategy hiển thị rõ
# provider đang chạy (GET /ai-strategy/provider).
# Điền MỘT trong hai key dưới đây để dùng LLM thật:
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Python dùng để validate/chạy strategy do AI sinh.
# Bỏ trống: hệ thống tự tìm theo thứ tự (1) venv workers/news/.venv nếu có
# (đúng layout HĐH: Scripts\python.exe trên Windows, bin/python trên
# Linux/macOS), (2) 'python' trên Windows / 'python3' trên Linux/macOS
# lấy từ PATH.
# Worker này chỉ dùng thư viện chuẩn nên bất kỳ CPython 3.10+ nào cũng chạy.
# AI_STRATEGY_PYTHON_BIN=
# AI_STRATEGY_WORKER_DIR=
# AI_STRATEGY_VALIDATE_TIMEOUT_MS=10000
# AI_STRATEGY_RUN_TIMEOUT_MS=30000
# AI_STRATEGY_MAX_OUTPUT_BYTES=5000000

# --- News crawler worker ----------------------------------------------
# Python cho news crawler. Bỏ trống: tự tìm venv workers/news/.venv (đúng
# layout HĐH), rồi mới tới python trên PATH.
# LƯU Ý: khác worker AI, worker này CẦN dependency thật (feedparser, bs4,
# psycopg2...), nên phải tạo venv theo workers/news/README.md — fallback
# PATH chỉ làm thông báo lỗi dễ đọc, không tự sinh ra dependency.
# NEWS_WORKER_PYTHON_BIN=
# NEWS_WORKER_DIR=
# NEWS_WORKER_SCRIPT=main.py
# NEWS_WORKER_TIMEOUT_MS=600000

# Tên model sentiment hiển thị kèm kết quả (GET /sentiment/*).
# SENTIMENT_MODEL_NAME=

# Các biến dưới đây do CHÍNH tiến trình worker Python đọc (được kế thừa từ
# môi trường của API khi spawn), xem workers/news/README.md:
#   SENTIMENT_PROVIDER=finbert   # finbert | none/noop/disabled
#   SENTIMENT_MODEL_PATH=        # mặc định workers/news/models/finbert
#   NEWS_DB_HOST / NEWS_DB_PORT / NEWS_DB_NAME / NEWS_DB_USER / NEWS_DB_PASSWORD
#     (bỏ trống thì dùng lại DATABASE_* ở trên)
